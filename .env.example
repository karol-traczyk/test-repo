# Region Configuration
# Copy this file to .env and update with your desired region

# AWS Region (default: us-east-1)
# Common options: us-east-1, us-west-2, eu-west-1, eu-central-1, ap-southeast-1, ap-northeast-1
AWS_REGION=us-east-1

# Application Environment
ENVIRONMENT=development

# Optional: Additional region-specific settings
# BACKUP_REGION=us-west-2
# ENABLE_MULTI_REGION=false
